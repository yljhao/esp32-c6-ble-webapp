mainmenu "XIAO ESP32-C6 BLE Web App"

config C6_BOOT_MARKER_DELAY_MS
	int "Delay before the first Marker, ms"
	default 2000
	help
	  The USB-Serial/JTAG console drops bytes while no host reads the port,
	  and a host that resets the board needs a moment to (re)open it. The
	  firmware waits this long before printing "[BOOT] reason=" so a capture
	  started right after a reset or a flash sees the first Marker.

config C6_HANG_CMD
	bool "Debug: the debug hang serial-shell command"
	default n
	depends on SHELL
	help
	  Adds "debug hang" (src/debug_hang.c): the main loop stops feeding
	  the watchdog, so the board must reset within the watchdog window and
	  the next boot report "[BOOT] reason=watchdog". Enabled by debug.conf
	  in a separate build directory; never in the production image.

config C6_HEAP_REPORT
	bool "Debug: print the kernel heap statistics every 5 s"
	default n
	select SYS_HEAP_RUNTIME_STATS
	help
	  Adds src/debug_heap.c. Enabled by analyze.conf (with the thread
	  analyzer) in a build directory of its own; never in the production
	  image.

source "Kconfig.zephyr"
